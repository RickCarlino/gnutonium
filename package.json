{
  "name": "gnutonium",
  "version": "2.1.1",
  "description": "Gnutonium is a small Gnutella client for Bun, usable as a CLI or TypeScript library.",
  "license": "GPL-3.0-only",
  "bin": {
    "gnutonium": "./bin/gnutonium.ts"
  },
  "main": "./src/protocol.ts",
  "types": "./src/protocol.ts",
  "exports": {
    ".": "./src/protocol.ts",
    "./types": "./src/types.ts",
    "./gwebcache": "./src/gwebcache_client.ts",
    "./query-routing": "./src/routing/index.ts"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "QUICKSTART.md",
    "CLI.md",
    "DEVELOPER.md",
    "LICENSE",
    "gnutella.json.example",
    "logo.png"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "keywords": [
    "gnutella",
    "p2p",
    "peer-to-peer",
    "bun",
    "cli"
  ],
  "homepage": "https://github.com/RickCarlino/gnutella-bun-client#readme",
  "bugs": {
    "url": "https://github.com/RickCarlino/gnutella-bun-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RickCarlino/gnutella-bun-client.git"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/eslint-parser": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@types/node": "^25.5.0",
    "bun-types": "^1.3.11",
    "eslint": "^9.24.0",
    "jscpd": "^4.0.8",
    "prettier": "^3.5.3",
    "ts-unused-exports": "^11.0.1",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "build:all": "./scripts/build-all-targets.sh",
    "dupcheck": "jscpd",
    "format:check": "prettier --check AGENTS.md README.md bin package.json tsconfig.json gnutella.json.example src tests scripts --ignore-unknown",
    "format:write": "prettier --write AGENTS.md README.md bin package.json tsconfig.json gnutella.json.example src tests scripts --ignore-unknown",
    "lint": "eslint bin src tests scripts --ext .ts",
    "test": "bun test",
    "test:integration": "bun test tests/integration",
    "test:unit": "bun test tests/unit",
    "typecheck": "tsc --noEmit",
    "unused-exports": "ts-unused-exports tsconfig.json \"--excludePathsFromReport=src/protocol.ts;src/routing/index.ts\" --exitWithCount",
    "fix": "./scripts/fix-all.sh",
    "verify": "./scripts/verify-all.sh",
    "test:interop": "./scripts/test-interop.sh",
    "imports:organize": "bun run scripts/organize-imports.ts",
    "imports:check": "bun run scripts/organize-imports.ts --check"
  }
}
